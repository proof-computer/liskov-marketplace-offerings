{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "uptime-prober",
  "metadata": {
    "appType": "background-worker",
    "labels": ["uptime", "monitoring", "telegram", "webview"],
    "description": "Uptime Prober"
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "aes256_gcm"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "proof-computer/liskov-marketplace-offerings",
      "allowedRefs": ["refs/heads/main"],
      "workflowRef": "proof-computer/liskov-marketplace-offerings/.github/workflows/uptime-prober.yml@refs/heads/main",
      "manifestPath": "uptime-prober/.liskov/uptime-prober.policy.json"
    }
  },
  "runtime": {
    "engine": "nodejs",
    "role": "uptime-prober",
    "resources": {
      "memoryMiB": 512,
      "storageMiB": 64,
      "networkRequestQuota": 256
    },
    "requiredModules": [],
    "bootstrap": {
      "trustProfile": "proof.liskov.attested-runtime.v1",
      "signedDiagnosticsRequired": true,
      "identityBoundSecretsRequired": true
    }
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 1800000,
      "startDelayMs": 300000,
      "maxStartDelayMs": 300000
    },
    "placement": {
      "requirements": {
        "trustProfile": "proof.liskov.attested-runtime.v1"
      },
      "processorSelection": {
        "mode": "open_market",
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "candidateLimit": 16
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "fixed",
          "durationMs": 300000
        }
      },
      "update": {
        "timing": "next_scheduled_renewal",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 5
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "40000000000",
      "maxNativeFeePlanckPerJob": "10000000000"
    }
  },
  "ingress": {},
  "observability": {
    "logs": {
      "enabled": true,
      "sinkName": "uptime-prober",
      "context": {}
    },
    "runtimeDiagnostics": {
      "signed": true
    }
  },
  "configuration": {
    "variables": [
      {
        "name": "UPTIME_PROBER_HOST",
        "required": true,
        "managed": true
      },
      {
        "name": "UPTIME_PROBER_TG_CHAT_ID",
        "required": true,
        "managed": true
      }
    ],
    "secrets": [
      {
        "secretId": "uptime-prober-tg-bot-token",
        "required": true,
        "destination": {
          "kind": "env",
          "name": "UPTIME_PROBER_TG_BOT_TOKEN"
        },
        "bundleId": "uptime-prober-tg"
      }
    ]
  }
}
