{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 5,
  "applicationId": "uptime-prober",
  "metadata": {
    "description": "Screenshot a URL every 30 minutes and alert a Telegram chat when it is down.",
    "labels": [
      "uptime",
      "monitoring",
      "telegram"
    ]
  },
  "release": {
    "mode": "source"
  },
  "runtime": {
    "kind": "javascript",
    "engine": "nodejs",
    "entrypoint": {
      "file": "bundle.cjs"
    }
  },
  "execution": {
    "mode": "continuous"
  },
  "deployment": {
    "jobs": 1,
    "schedule": {
      "duration": "30m"
    },
    "placement": {
      "minimums": {
        "memory": "512MiB",
        "storage": "64MiB"
      }
    },
    "spend": {
      "unit": "service_credit_micros",
      "perJob": "300000",
      "rate": {
        "amount": "15000000",
        "window": "1d"
      }
    }
  },
  "state": {
    "mode": "off"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
