{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "rust-hello-world",
  "metadata": {
    "appType": "background-worker",
    "description": "Unlisted native Rust example for the Liskov Cargo runtime-image path.",
    "labels": [
      "liskov",
      "rust",
      "cargo-runtime-image",
      "unlisted-example",
      "runtime-ssh-tailscale-private-preview-canary-v26"
    ]
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "runtime_image"
    },
    "builder": {
      "kind": "github",
      "repository": "proof-computer/liskov-marketplace-offerings",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "proof-computer/liskov-marketplace-offerings/.github/workflows/rust-hello-world.yml@refs/heads/main",
      "manifestPath": ".liskov/rust-hello-world.policy.json"
    }
  },
  "runtime": {
    "command": "/usr/local/bin/rust-hello-world",
    "maxGenerations": 1,
    "role": "background-worker",
    "resources": {
      "memoryMiB": 128,
      "storageMiB": 256,
      "networkRequestQuota": 0
    },
    "requiredModules": [],
    "bootstrap": {
      "trustProfile": "proof.liskov.attested-runtime.v1",
      "signedDiagnosticsRequired": true,
      "identityBoundSecretsRequired": true
    }
  },
  "deployment": {
    "parallelism": 1,
    "placement": {
      "processorSelection": {
        "mode": "static",
        "processorIds": [
          "5H9yzELTGKhjAH2MW77HqK6nvqT4zgScnCF3U3tzeuY7mRK8"
        ],
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "maxHeartbeatAgeSeconds": 43200,
        "candidateLimit": 1
      }
    },
    "schedule": {
      "durationMs": 2700000,
      "startDelayMs": 900000,
      "maxStartDelayMs": 900000
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "fixed",
          "durationMs": 60000
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 0
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "20000000000",
      "maxNativeFeePlanckPerJob": "10000000000"
    }
  },
  "ingress": {
    "ssh": {
      "mode": "required",
      "provider": {
        "kind": "tailscale",
        "integrationId": "int_8178e0f43ab09d284fe719d0a6d908dc",
        "port": 22
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": false
    },
    "runtimeDiagnostics": {
      "signed": true
    }
  }
}
