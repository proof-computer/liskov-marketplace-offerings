{
  "schemaVersion": 1,
  "entryId": "proof/uptime-prober",
  "displayName": "Uptime Prober",
  "summary": "Screenshots your site every 5 minutes from inside a mobile TEE and delivers it to your own Telegram bot.",
  "description": "An Acurast app that, on a fixed 5-minute tick, renders a user-given URL **entirely inside the device WebView** (via Chrome DevTools Protocol), captures a PNG, and sends it to **your own Telegram bot** with a status caption (HTTP status, latency, timestamp). No PROOF bot and no provider secret — you supply the host plus your own bot token and chat id. The whole screenshot path runs in-job, with no dependency on Liskov or any external service beyond launch.",
  "labels": ["uptime", "monitoring", "telegram"],
  "appType": "background-worker",
  "wedgeCategory": "residential-tee",
  "source": {
    "repository": "proof-computer/liskov-marketplace-offerings",
    "ref": "refs/heads/main",
    "path": "uptime-prober/.liskov/uptime-prober.policy.json"
  },
  "artifact": {
    "cid": "ipfs://QmQCpRJ593xRyKko9smvtFixzfAGwDuG6gXBemRtUeSe4U",
    "digest": "sha256:7545ffe44288c548ff4dea09ef0c0dc318a8dd490c5dc822becec3ff0d307d57",
    "requiredEncryptionMode": "none"
  },
  "policyTemplate": {
    "schema": "proof.liskov.application-manifest",
    "schemaVersion": 4,
    "applicationId": "uptime-prober",
    "metadata": {
      "appType": "background-worker",
      "labels": ["uptime", "monitoring", "telegram"]
    },
    "release": {
      "mode": "pinned",
      "artifact": {
        "kind": "ipfs_bundle",
        "cid": "ipfs://QmQCpRJ593xRyKko9smvtFixzfAGwDuG6gXBemRtUeSe4U",
        "digest": "sha256:7545ffe44288c548ff4dea09ef0c0dc318a8dd490c5dc822becec3ff0d307d57",
        "encryption": {
          "mode": "none"
        }
      }
    },
    "runtime": {
      "engine": "nodejs",
      "resources": {
        "memoryMiB": 512,
        "storageMiB": 64,
        "networkRequestQuota": 256
      },
      "bootstrap": {
        "trustProfile": "proof.liskov.attested-runtime.v1",
        "signedDiagnosticsRequired": true,
        "identityBoundSecretsRequired": true
      }
    },
    "deployment": {
      "parallelism": 1,
      "schedule": {
        "durationMs": 1800000,
        "startDelayMs": 300000,
        "maxStartDelayMs": 300000
      },
      "placement": {
        "requirements": {
          "trustProfile": "proof.liskov.attested-runtime.v1"
        },
        "processorSelection": {
          "mode": "open_market",
          "requireScheduleClear": true,
          "requireConsumerAccess": true,
          "candidateLimit": 16
        }
      },
      "lifecycle": {
        "renewal": {
          "mode": "before_scheduled_end",
          "leadTime": {
            "mode": "fixed",
            "durationMs": 300000
          }
        },
        "update": {
          "timing": "next_scheduled_renewal",
          "existingJobs": {
            "mode": "run_until_scheduled_end"
          }
        },
        "recovery": {
          "launch": {
            "maxRetries": 5
          },
          "runtimeFailure": {
            "mode": "wait_until_scheduled_end"
          }
        }
      },
      "spend": {
        "maxRewardPlanckPerJob": "40000000000",
        "maxNativeFeePlanckPerJob": "10000000000"
      }
    },
    "ingress": {},
    "observability": {
      "logs": {
        "enabled": true,
        "sinkName": "uptime-prober",
        "context": {}
      },
      "runtimeDiagnostics": {
        "signed": true
      }
    },
    "configuration": {
      "variables": [],
      "secrets": []
    }
  },
  "optionsSchema": {
    "host": {
      "type": "env",
      "source": "user",
      "required": true,
      "target": "UPTIME_PROBER_HOST",
      "delivery": "slipway",
      "default": "https://example.com",
      "label": "Host to probe",
      "description": "URL screenshotted every 5 minutes (e.g. https://example.com)."
    },
    "telegramBotToken": {
      "type": "secret",
      "source": "user",
      "required": true,
      "target": "UPTIME_PROBER_TG_BOT_TOKEN",
      "secretBundleId": "uptime-prober-tg",
      "label": "Telegram bot token",
      "description": "In Telegram, open the verified @BotFather account, send /newbot, follow the prompts, and copy the HTTP API token. Paste it only here; Liskov seals it via Lockbox and never writes it into the policy."
    },
    "telegramChatId": {
      "type": "env",
      "source": "user",
      "required": true,
      "target": "UPTIME_PROBER_TG_CHAT_ID",
      "delivery": "slipway",
      "label": "Telegram chat ID",
      "description": "Open your new bot and send /start. Then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the numeric result[].message.chat.id value."
    }
  },
  "pricingRequest": { "model": "free" }
}
